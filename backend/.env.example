DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2

# --- Email ---
# Dev: print OTP in the runserver terminal (no real inbox)
EMAIL_USE_CONSOLE=True

# Production / real Gmail (set EMAIL_USE_CONSOLE=False and fill these):
# Gmail does NOT accept your normal password — create an App Password:
# https://myaccount.google.com/apppasswords  (requires 2-Step Verification)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
